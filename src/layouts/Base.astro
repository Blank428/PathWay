---
import '../styles/global.css';
import site from '../content/site.json';
import ufe from '../content/procedures/ufe.json';
import { rootFor, PAGES } from '../lib/paths';

interface Props { title: string; description?: string; current?: 'guides' | 'library' | 'about'; bare?: boolean }
const { title, description = 'Printed 3D models and patient guides for Interventional Radiology at Victoria General Hospital.', current, bare = false } = Astro.props;
const root = rootFor(Astro.url.pathname);
const link = (k: keyof typeof PAGES) => root + PAGES[k];
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
---
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Atkinson+Hyperlegible+Next:ital,wght@0,300..800;1,400..700&family=Atkinson+Hyperlegible+Mono:wght@400;500&display=swap" />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='1' y='1' width='30' height='30' rx='9' fill='#111513'/><circle cx='16' cy='16' r='6.5' fill='none' stroke='#fff' stroke-width='3'/><circle cx='16' cy='16' r='2' fill='#ee8a2a'/></svg>")}`} />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={link('home')}>
          <svg class="brand-mark" viewBox="0 0 26 26" aria-hidden="true"><rect x="0.5" y="0.5" width="25" height="25" rx="8" fill="currentColor"/><circle cx="13" cy="13" r="5.2" fill="none" stroke="var(--paper)" stroke-width="2.4"/><circle cx="13" cy="13" r="1.6" fill="#ee8a2a"/></svg>
          <span class="brand-name">{site.name}</span>
          <span class="brand-sub">IR models · {site.hospital}</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a href={link('guides')} aria-current={current === 'guides' ? 'page' : undefined}>Guides</a>
          <a href={link('library')} aria-current={current === 'library' ? 'page' : undefined}>Library</a>
          <a href={link('about')} aria-current={current === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    {!bare && (
      <footer class="site-footer">
        <div class="wrap">
          <div class="cell">
            <span class="label">{site.name}</span>
            <p style="margin-top:8px">Printed models and patient guides for procedures done by the {site.unit} team at {site.hospital}. Guides explain procedures in general and are not advice about your own care. If you feel unwell, contact your care team or go to the nearest emergency department.</p>
            <p class="review-chip mono"><span class="review-dot" aria-hidden="true"></span>{ufe.review.date ? `Reviewed by ${ufe.review.by}, ${ufe.review.date}` : `Draft. Clinical review by ${ufe.review.by} pending.`}</p>
          </div>
          <div class="cell">
            <span class="label">For patients</span>
            <nav aria-label="For patients">
              <a href={link('guides')}>All guides</a>
              <a href={link('ufe')}>Uterine fibroid embolization guide</a>
              <a href={link('visit')}>Your UFE visit: recovery and questions</a>
              <a href={link('text')}>The UFE guide as text</a>
            </nav>
          </div>
          <div class="cell">
            <span class="label">For clinicians</span>
            <nav aria-label="For clinicians">
              <a href={link('library')}>Model library</a>
              <a href={link('ufeProject')}>P-001 Uterine fibroid embolization</a>
              <a href={link('clinicians')}>Using the models in clinic</a>
              <a href={link('about')}>About {site.name}</a>
            </nav>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
